# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Node
node_modules/
frontend/node_modules/
frontend/dist/

# Environment
.env
*.env.local

# GCP service-account keys — NEVER commit
gcp-key.json
*-key.json
*service-account*.json
*-sa.json
cloud-sql-proxy.exe

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Resumes (user data)
resumes/

# Evidence frames (proctoring)
evidence_frames/

# Temp
*.tmp
*.bak
venv/

# Uploads (user data — candidate photos/resumes; never commit, PII)
uploads/
backend/uploads/photos/
backend/upload/photos/

# Logos (tenant/company assets — not tracked in git)
logos/
# Local DB backups (created before backfills/migrations)
backend/backups/

# Rollback point for the deploy pipeline: the last frontend bundle that passed a
# health check, kept on the server so a failed deploy can put the old UI back.
# Written by .github/workflows/deploy.yml, never by a developer.
.dist-prev/

# Deploy manifest and history, written on the server by .github/workflows/deploy.yml.
# backend/main.py reads .release.json for /api/v1/version and the startup log.
.release.json
.release-history.jsonl
.dist-prev.version
