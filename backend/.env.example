# =====================================================
# HIREFLOW RECRUITMENT SYSTEM - ENVIRONMENT CONFIGURATION
# =====================================================
# Copy this file to .env and update with your actual values

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/recruitment_db

# Security Configuration
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Absolute session ceiling: /auth/refresh stops this many hours after sign-in.
SESSION_MAX_HOURS=12
# Roles that must use TOTP two-factor sign-in (enrolled at their next login).
MFA_REQUIRED_ROLES=superadmin,admin
MFA_ISSUER=HireFlow
# Per-account lockout after repeated wrong passwords / MFA codes.
LOGIN_LOCKOUT_THRESHOLD=10
LOGIN_LOCKOUT_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15
# Rate-limit store shared by all workers (falls back to REDIS_URL, then memory).
# RATE_LIMIT_STORAGE_URI=redis://127.0.0.1:6379/2
# Our own reverse proxies; X-Forwarded-For is trusted only through these.
# TRUSTED_PROXIES=127.0.0.0/8,::1
# Superadmin raw SQL console (POST /api/v1/database/query). Off unless set.
# ENABLE_RAW_SQL_CONSOLE=false

# AI/ML Configuration (Google Cloud Vertex AI)
# Powers interview-question generation, JD generation, cover letters, and the
# qualitative ATS layer. Requires a GCP project with the Vertex AI API enabled
# (`gcloud services enable aiplatform.googleapis.com`) and Application Default
# Credentials. Local dev auth: `gcloud auth application-default login`
# (or set GOOGLE_APPLICATION_CREDENTIALS to a service-account key JSON path).
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
VERTEX_LOCATION=us-central1
GEMINI_MODEL=gemini-flash-latest

# Talent-pool resume extraction. The regex parser runs first and stays authoritative;
# Gemini is asked only about fields it left blank (name, college, degree, role…), and
# anything it returns for an already-filled field is discarded. No call is made when a
# resume parsed cleanly, so a well-formed batch costs nothing. Set to false to keep the
# regex-only behaviour; it is a no-op anyway without credentials above.
RESUME_LLM_EXTRACTION=true
# How many resumes in one upload may be gap-filled at once.
RESUME_LLM_CONCURRENCY=5
# Characters of resume text sent per call — identity fields sit near the top.
RESUME_LLM_TEXT_CHARS=6000

# How many sentence-transformer embeddings to keep cached (LRU). One resume uses roughly
# one entry per section plus one per job description, so a large batch scored against many
# open roles wants headroom here — too small and it evicts the job embeddings it re-reads.
ATS_EMBEDDING_CACHE_SIZE=512

# File Upload Configuration
UPLOAD_DIR=./resumes
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=pdf

# ── Email API (docs/EMAIL_API.md) ─────────────────────────────────────────────
# Keys for mailbox passwords and stored message content: "<version>:<fernet key>",
# comma-separated, newest first. REQUIRED — without it no mailbox can be saved and
# the platform's own mailboxes below are not set up. Generate one with
#   python -c "from cryptography.fernet import Fernet; print('k1:' + Fernet.generate_key().decode())"
# Rotate: prepend k2:..., restart, run scripts/reencrypt_email_credentials.py, drop k1.
EMAIL_CREDENTIAL_KEYS=
# EMAIL_DELIVERY_MODE=null     # development: accept and record mail, never connect to a server
# EMAIL_DISPATCH_INTERVAL_S=5  # outbox dispatcher poll interval
# EMAIL_SEND_LEASE_S=180       # a send not finished in this time becomes "unknown"
# EMAIL_PUBLISH_LEASE_S=300    # a published job not picked up in this time is published again
# EMAIL_SMTP_EXTRA_PORTS=      # ops-approved extra ports, e.g. 2465:implicit_tls,2587:starttls_required
# EMAIL_SMTP_HOST_DENYLIST=    # comma-separated domains mailboxes may never point at
# EMAIL_API_KEY_HOURLY_QUOTA=500        # default per-API-key messages per hour
# EMAIL_TENANT_HOURLY_SUBMIT_QUOTA=2000 # per company, all of its API keys together
# EMAIL_API_KEY_PEPPER=        # optional HMAC pepper for stored API key hashes
# EMAIL_MSGID_DOMAIN=hireflow.io

# The PLATFORM company's own mailboxes. Not a fallback for anyone: at startup they
# are turned into the platform's email connections (SMTP_* -> "Platform System",
# which also sends verification/reset codes for companies with no mailbox;
# INNOMAX_* -> the platform's HR and official senders). Companies send only from
# mailboxes they connect in Admin -> Email Settings. Port must be 465 or 587.
# Gmail needs an App Password (not your normal password) with 2FA enabled.
# EMAIL_ENABLED=false pauses delivery: mail is kept and deferred, not dropped.
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
FROM_EMAIL=your-email@gmail.com
# SMTP_TIMEOUT_S=15        # SMTP socket timeout; keep well under EMAIL_JOB_TIMEOUT_S
# SMTP certificates are always verified; SMTP_TLS_VERIFY=false is no longer honoured.
# Log outbound message bodies for local debugging. Requires DEBUG level as well,
# so flipping the app to DEBUG for an unrelated bug does not start dumping mail.
# OTP and password-reset bodies are excluded unconditionally and cannot be
# re-enabled by this. Offer letters CAN be logged when it is on (salary, bonus,
# terms), so never set it in production.
# EMAIL_LOG_BODIES=true

# Innomax (platform) per-category senders — OPTIONAL.
# Only used for the platform's own (Innomax) company; client companies are unaffected.
# Leave HR/OFFICIAL user+pass blank to keep all Innomax mail on the default SMTP_* above (Gmail).
#   candidate-handling mail -> INNOMAX_HR_USER ; client-company-handling mail -> INNOMAX_OFFICIAL_USER
# Put real passwords in your local .env (gitignored) or, in production, in Cloud Run / Secret Manager.
# INNOMAX_SMTP_HOST=mail.innomaxsol.com
# INNOMAX_SMTP_PORT=465
# INNOMAX_HR_USER=hr@innomaxsol.com
# INNOMAX_HR_PASS=the-hr-mailbox-password
# INNOMAX_OFFICIAL_USER=official@innomaxsol.com
# INNOMAX_OFFICIAL_PASS=the-official-mailbox-password

# Redis Configuration (Optional - for caching and background tasks)
REDIS_URL=redis://localhost:6379/0

# ── Coding Judge ─────────────────────────────────────────────────────────────
# Execution backend: 'docker' (default; local sandbox, needs Docker Desktop) or
# 'judge0' (remote Judge0 server — used in the cloud / high-traffic deployment).
JUDGE_BACKEND=docker
# Judge0 server (only when JUDGE_BACKEND=judge0). On Cloud Run point at the judge
# VM's PRIVATE IP over the VPC connector.
# JUDGE0_URL=http://10.x.x.x:2358
# JUDGE0_TOKEN=                       # must equal AUTHN_TOKEN on the Judge0 server
# Override Judge0 language ids if your server build differs (defaults: 71/54/63/62):
# JUDGE0_LANG_PYTHON=71
# JUDGE0_LANG_CPP=54
# JUDGE0_LANG_JAVASCRIPT=63
# JUDGE0_LANG_JAVA=62

# On-demand judge VM (cost saver): start the VM when a coding test begins, stop it
# when idle. Leave JUDGE_AUTOSTART=0 unless deploying the GCP judge VM.
JUDGE_AUTOSTART=0
# JUDGE_GCP_PROJECT=my-project
# JUDGE_GCP_ZONE=us-central1-a
# JUDGE_VM_NAME=hireflow-judge
# JUDGE_IDLE_STOP_MIN=30              # reaper stops the VM after this many idle minutes
# JUDGE_REAP_TOKEN=                   # shared secret Cloud Scheduler sends to POST /api/v1/judge/reap
# JUDGE_REGRADE_TOKEN=                # shared secret the regrade timer sends to POST /api/v1/judge/regrade-pending.
#                                     # Unset = no timer sweep; coding answers deferred during a judge
#                                     # outage stay ungraded until someone re-grades by hand.

# Recruiter workflow: stage-deadline reminders (deploy/cpanel/hireflow-reminders.timer).
# WORKFLOW_REMINDER_TOKEN=            # shared secret the timer sends to POST /api/v1/hr/workflow/reminders/run.
#                                     # Unset = no timer sweep; HR can still run it from their own login.
# WORKFLOW_REMINDER_EMAIL=1           # 0 = in-app notifications only, no digest emails

# Outbound email queue (rate-limited async sending).
#   Requires Redis, an email worker (`python scripts/run_email_worker_windows.py`
#   / ROLE=email-worker) and the outbox dispatcher
#   (`python scripts/run_email_dispatcher_windows.py` / ROLE=email-dispatcher).
#   Without Redis, mail waits in the database outbox; only verification and
#   password-reset codes are sent immediately.
# EMAIL_SYNC=1                 # dev: deliver every email in-process after commit
# EMAIL_QUEUE=email            # RQ queue name
# EMAIL_REDIS_URL=redis://localhost:6379/0   # defaults to REDIS_URL
EMAIL_HOURLY_LIMIT=100         # default max sends/hour per mailbox (Admin can override per mailbox)
EMAIL_MAX_RETRIES=5            # transient-failure retry attempts (exponential backoff)

# Application Configuration
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:3001

# CORS Configuration
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ATS Scoring Weights
# NOT configurable here. Nothing reads these variables — the rubric lives in
# DEFAULT_ATS_WEIGHTS in backend/src/services/enhanced_ats_service.py, which is
# the single source of truth. The values below were also the superseded
# four-factor rubric. Kept only so anyone who copied them knows why they never
# took effect. Current rubric: education 35 / skills 25 / experience 20 /
# certification 10 / project 8 / semantic 1 / keyword 1.

# Monitoring (Optional)
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# Background Tasks (Optional)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# File Storage (Optional - for cloud storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-s3-bucket

# Webhook Configuration (Optional)
WEBHOOK_BASE_URL=https://yourcompany.com/webhooks
WEBHOOK_SECRET=your-webhook-secret

# Feature Flags
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_BACKGROUND_TASKS=false
ENABLE_CACHING=false
ENABLE_MONITORING=false
