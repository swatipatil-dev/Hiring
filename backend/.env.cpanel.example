# =====================================================
# HIREFLOW — cPanel / self-hosted environment template
# =====================================================
# Copy to backend/.env on the server and fill in real values:
#   cp .env.cpanel.example .env && chmod 600 .env
#
# This file is the authoritative template for the self-hosted deployment.
# backend/.env.example is the older GCP-oriented one, kept only for reference.
#
# Values marked [CARRY OVER] must be copied verbatim from the OLD deployment if
# you are migrating data. They existed only in the live Cloud Run service, not in
# this repository, so capture them before that service is torn down:
#   gcloud run services describe hire-flow-api --region us-central1 --format export

# ── Database ─────────────────────────────────────────────────────────────────
# cPanel prefixes every database and user with the account name.
DATABASE_URL=mysql+pymysql://acct_hireflow_user:PASSWORD@localhost:3306/acct_hireflow

# REQUIRED on any managed host. When 1 (the default) the app tries to run
# CREATE DATABASE / CREATE USER / GRANT as root@localhost on every worker boot.
# On cPanel you have no such grant, so it fails on every start and logs noise.
DB_BOOTSTRAP=0

# The defaults (20 + 30 overflow) are 50 connections PER WORKER. With 2 workers
# that is 100, which will exhaust a normal MySQL connection limit.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=3600

# ── Security ─────────────────────────────────────────────────────────────────
# [CARRY OVER] Keeping the existing value avoids invalidating every issued JWT
# at cutover. The app REFUSES TO START if this is unset or left as a placeholder.
# Generate a fresh one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── LLM: Gemini Developer API ────────────────────────────────────────────────
# Get a key from https://aistudio.google.com/apikey
# Setting this switches the client off Vertex AI/ADC, which cannot authenticate
# outside GCP. Leave GOOGLE_CLOUD_PROJECT unset — if both are present the API
# key wins, but an unset project makes the active mode unambiguous.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ── File storage ─────────────────────────────────────────────────────────────
# Uploads live on the local filesystem instead of a GCS bucket.
STORAGE_BACKEND=local
# Root that storage keys (resumes/, logos/, uploads/, cover_letters/) resolve
# against. Defaults to the backend/ directory. Set explicitly if you keep
# uploads on a separate volume — this is the directory the GCS data is synced
# into during migration, and main.py serves its subdirectories.
# HIREFLOW_DATA_DIR=/opt/hireflow/backend
# BACKUP_DIR=/opt/hireflow/backups

# ── Coding judge ─────────────────────────────────────────────────────────────
# 'docker' runs the hardened local sandbox (backend/judge/images/*). It needs
# the docker CLI + daemon and the hireflow-judge-* images built via
# scripts/build_judge_images.sh. Unlike the judge0 backend it also supports SQL
# questions. Requires a judge RQ worker process (ROLE=worker).
JUDGE_BACKEND=docker
JUDGE_WORK_ROOT=/srv/judge_work

# GCE VM autostart — must stay 0 off GCP. The provisioner calls the Compute API
# via the metadata server, which does not exist here. At 0 those calls are inert.
JUDGE_AUTOSTART=0

# ── Redis / background queues ────────────────────────────────────────────────
# Needs an email worker (ROLE=email-worker) and a judge worker (ROLE=worker).
# Without Redis both fall back to inline execution on the request thread.
REDIS_URL=redis://127.0.0.1:6379/0
EMAIL_HOURLY_LIMIT=100
EMAIL_MAX_RETRIES=5

# ── Email / SMTP ─────────────────────────────────────────────────────────────
# Unlike Cloud Run, a normal server does not block port 25 — but keep using an
# authenticated relay on 587/465 so mail is not treated as spam.
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=

# [CARRY OVER] — CRITICAL when migrating. This decrypts the per-mailbox SMTP
# passwords stored in the rows you are importing. Get it wrong and decrypt()
# returns "" rather than raising (src/security.py:42) — mail silently stops
# working with no error anywhere.
#
# BEWARE THE FALLBACK. src/security.py resolves the key in this order:
#   1. EMAIL_ENCRYPTION_KEY, used as-is
#   2. SECRET_KEY, hashed SHA-256 -> urlsafe base64
#   3. the literal "hireflow-dev-key-change-me"
#
# So if the OLD deployment never set EMAIL_ENCRYPTION_KEY, the real key was
# derived from its SECRET_KEY — and generating a fresh SECRET_KEY here changes
# it. Leaving this blank in that situation is exactly how the data becomes
# unreadable. Derive the old key explicitly instead:
#
#   python3 -c "import hashlib,base64; \
#     print(base64.urlsafe_b64encode(hashlib.sha256(b'OLD_SECRET_KEY').digest()).decode())"
#
# and set the result below. That frees you to use a new SECRET_KEY here while
# still reading the old encrypted passwords.
#
# Fresh install (no data to migrate): leave blank.
EMAIL_ENCRYPTION_KEY=

# Optional per-category Innomax senders (see .env.example for the full notes).
# INNOMAX_SMTP_HOST=mail.innomaxsol.com
# INNOMAX_SMTP_PORT=465
# INNOMAX_HR_USER=
# INNOMAX_HR_PASS=
# INNOMAX_OFFICIAL_USER=
# INNOMAX_OFFICIAL_PASS=

# ── Proctoring ───────────────────────────────────────────────────────────────
# Pre-warms the shared inference models at startup. The imports alone cost ~102s,
# so leaving this on avoids freezing the first candidate who starts a test.
PROCTOR_PREWARM=1

# How many frames may be in inference at once. This is THE capacity knob: models
# are shared, so resident memory is roughly slots x ~115 MB and does NOT grow with
# the number of candidates (measured: ~45 KB per additional session).
# Default is (cpu_count - 2), i.e. 6 on an 8 vCPU box. Leave 2 cores for MySQL,
# Apache, the judge containers and the event loop.
PROCTOR_INFERENCE_SLOTS=6

# Ceiling on concurrent proctored candidates; past this, /sessions/start returns
# 503 with Retry-After rather than degrading everyone already mid-test.
# Defaults to slots * 1.5. Calibrate against `peak_in_use` and `waits` from
# GET /api/v1/proctor/warmup under real load.
PROCTOR_MAX_SESSIONS=9

# How long a frame waits for a free inference slot before erroring (seconds).
# PROCTOR_BORROW_TIMEOUT_S=30

# Sets to pre-build at startup. Defaults to full capacity. Lower it to trade
# first-session latency for faster startup and lower idle memory.
# PROCTOR_PREWARM_SLOTS=2

# Keep OpenMP single-threaded to match the in-process caps on cv2/torch —
# parallelism comes from the shared executor, so a nested pool per inference just
# oversubscribes the CPU. Must be set in the environment, not in code.
OMP_NUM_THREADS=1

# Keep the HuggingFace cache inside the app directory rather than $HOME, so it
# survives and is shared regardless of which user starts the process.
HF_HOME=/opt/hireflow/hf-cache

# ── First accounts (REQUIRED on a fresh install) ─────────────────────────────
# Self-registration is candidate-only — HR, interviewer and admin accounts are
# created by an existing admin. So on an empty database there is no way in at
# all unless these are set: src/bootstrap.py seeds them at startup, and both are
# no-ops if the user already exists.
#
# Skip these and you get a working deployment you cannot administer.
#
# Generate passwords with:
#   python -c "import secrets; print(secrets.token_urlsafe(18))"
#
# Use addresses you can actually receive mail at — password resets go there.
# Once the accounts exist you may blank the passwords; the emails must stay, or
# the seeding is skipped entirely.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
# SUPERADMIN_FIRST_NAME=Super
# SUPERADMIN_LAST_NAME=Admin

PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
# PLATFORM_ADMIN_FIRST_NAME=Admin
# PLATFORM_ADMIN_LAST_NAME=User

# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# NOTE: PORT and WEB_CONCURRENCY are deliberately absent — see the block at the
# bottom of this file. Setting them here breaks the multi-service split.

# Used to build links in outbound email — must be the public HTTPS origin.
FRONTEND_URL=https://career.innomaxskills.com
PLATFORM_BASE_URL=https://career.innomaxskills.com

# Base domain for per-tenant slug subdomains (acme.career.innomaxskills.com → slug
# "acme"), resolved by src/middleware/tenant_domain.py. It defaults to
# "hireflow.io", so LEAVING THIS UNSET means slug resolution never matches and
# every request is treated as a single tenant — which is correct for a
# single-company deployment, but silently wrong if you later expect per-tenant
# subdomains. Exact Company.custom_domain matches work either way.
# HIREFLOW_BASE_DOMAIN=career.innomaxskills.com

# ── Deliberately NOT set on a self-hosted box ────────────────────────────────
# PORT, WEB_CONCURRENCY → per-service, set in the systemd units. Read on:
#
#   These were single-service settings from the Cloud Run deployment. Here four
#   services share this one file, and systemd applies EnvironmentFile= AFTER
#   Environment=, so a value here OVERRIDES the unit — the opposite of what you
#   would expect from the ordering inside the unit file.
#
#   Setting PORT=8000 therefore made hireflow-proctor bind 8000 instead of 8001.
#   It won the race, hireflow-api crash-looped on "Connection in use", and the
#   site kept working because the proctor service happened to be serving it —
#   while proctoring itself was unreachable and every candidate's face check sat
#   on "Checking…" forever. WEB_CONCURRENCY=2 likewise overrode the single worker
#   proctoring REQUIRES (its session state is process-local).
#
#   The proctor service now uses ROLE=proctor, which hardcodes one worker and
#   port 8001 in entrypoint.sh, so neither is reachable from here any more. Do not
#   reintroduce these keys: the API's worker count belongs in
#   hireflow-api.service.
#

# GOOGLE_CLOUD_PROJECT   → selects Vertex AI/ADC; unavailable outside GCP
# VERTEX_LOCATION        → Vertex only
# GCS_BUCKET             → only with STORAGE_BACKEND=gcs
# JUDGE0_URL / JUDGE0_TOKEN → only with JUDGE_BACKEND=judge0
# JUDGE_GCP_PROJECT / JUDGE_GCP_ZONE / JUDGE_VM_NAME / JUDGE_REAP_TOKEN
#                        → the on-demand GCE judge VM, replaced by local Docker
