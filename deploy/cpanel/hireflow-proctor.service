# HireFlow proctoring — the SAME app, serving only the proctoring routes.
#
# Why this is a separate service, and why it must stay at ONE worker:
#
# proctoring/routes.py keeps active sessions in a process-local dict whose values
# are live MediaPipe graph handles. Those cannot be serialised, so the state
# cannot move to Redis or be shared between workers. A session started by
# POST /sessions/start lives in exactly one process, and its WebSocket arrives as
# a NEW connection that gunicorn hands to an arbitrary worker — with N workers it
# lands on the right one 1/N of the time and closes 4004 otherwise.
#
# So: one worker, on its own port, with Apache routing the proctoring paths here.
# The API keeps its 3 workers because it has no such constraint.
#
# Capacity is set by PROCTOR_INFERENCE_SLOTS, not by worker count — models are
# pooled and borrowed per frame (proctoring/model_registry.py), so one process
# handles many candidates concurrently.

[Unit]
Description=HireFlow Proctoring (single worker — session state is process-local)
After=network.target mysqld.service hireflow-api.service

[Service]
Type=exec
User=hireflow
Group=hireflow
WorkingDirectory=/opt/hireflow/backend
EnvironmentFile=/opt/hireflow/backend/.env

# ROLE=proctor, not web. That role hardcodes one worker and port 8001 in
# entrypoint.sh instead of reading WEB_CONCURRENCY and PORT.
#
# It has to work that way. systemd applies EnvironmentFile= AFTER Environment=,
# so a value in the shared .env OVERRIDES what is pinned here — the opposite of
# what the ordering in this file suggests. PORT=8000 in .env duly beat an
# Environment=PORT=8001 pinned right here: proctoring bound 8000, won the startup
# race, hireflow-api crash-looped on "Connection in use", and the site kept
# serving from this process while proctoring itself was unreachable. Every
# candidate's face check sat on "Checking…" and every report came back clean.
#
# Pinning a correctness constraint in a unit file does not make it safe. Putting
# it in the code path does.
Environment=ROLE=proctor
Environment=BIND_HOST=127.0.0.1
Environment=PROCTOR_PREWARM=1
Environment=HF_HOME=/opt/hireflow/hf-cache

# PROCTOR_INFERENCE_SLOTS and PROCTOR_MAX_SESSIONS are deliberately NOT set here.
# They are the two knobs an operator tunes against real load, so they belong in
# .env — which, per the note above, is also the layer that wins. Anything pinned
# here would be un-tunable.
#
# Unset, the app defaults to (cpu_count - 2) slots and slots * 1.5 sessions.
Environment=OMP_NUM_THREADS=1
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/opt/hireflow/venv/bin:/usr/local/bin:/usr/bin:/bin

ExecStart=/bin/sh /opt/hireflow/backend/entrypoint.sh

Restart=always
RestartSec=5
# Cold start imports mediapipe/ultralytics/torch (~102s measured) before the
# first model set is built. Do not lower this without measuring.
TimeoutStartSec=600
TimeoutStopSec=60

# ── Resource limits: this server also hosts other cPanel accounts ────────────
# This is the heaviest service on the box — video inference for every candidate
# — so it gets the largest ceiling and the LOWEST cpu priority. Under load it
# yields to Apache, MySQL and the other accounts first.
#
# Sizing: measured ~604 MB for models plus 50 live sessions, on top of roughly
# 1 GB of resident torch/mediapipe imports. 10G leaves generous headroom; raise
# it only alongside PROCTOR_INFERENCE_SLOTS, since each slot costs ~115 MB.
MemoryMax=10G
MemoryHigh=9G
CPUWeight=40
IOWeight=40

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/hireflow

[Install]
WantedBy=multi-user.target
