# HireFlow coding-judge worker — runs candidate code in Docker sandboxes.
#
# Runs as its own user (hfjudge), NOT as hireflow, and that is deliberate.
#
# SECURITY: membership in the `docker` group is root-equivalent — a member can
# bind-mount the host filesystem into a container. This box hosts other cPanel
# accounts, so that privilege is confined to a dedicated user running exactly one
# process, rather than granted to the account that serves web traffic.
#
# If that is not an acceptable trade-off, run Judge0 on a separate machine and
# set JUDGE_BACKEND=judge0 with JUDGE0_URL pointing at it; the client for that
# path is still in the tree (src/judge/judge0_client.py).
#
# Prerequisites:
#   useradd -r -s /sbin/nologin -G docker hfjudge
#   mkdir -p /srv/judge_work && chown hfjudge:hfjudge /srv/judge_work && chmod 700 /srv/judge_work
#   bash backend/scripts/build_judge_images.sh   # builds hireflow-judge-{python,cpp,node,java}
#   Redis with a password, and that password in REDIS_URL (docs/CPANEL_DEPLOYMENT.md):
#   this worker runs whatever the queue hands it, within src/judge/rq_safety.py's list.

[Unit]
Description=HireFlow coding-judge RQ worker
After=network.target redis.service docker.service
Requires=docker.service
Wants=redis.service

[Service]
Type=exec
User=hfjudge
Group=hfjudge
SupplementaryGroups=docker
WorkingDirectory=/opt/hireflow/backend
EnvironmentFile=/opt/hireflow/backend/.env

Environment=ROLE=worker
Environment=JUDGE_BACKEND=docker
Environment=JUDGE_WORK_ROOT=/srv/judge_work

# Concurrent judge jobs. The API does NOT execute sandboxes itself — it enqueues
# here and blocks on the result inside the HTTP request — so this value is the
# ceiling on simultaneous "Run Code" presses before candidates start queueing.
# Each job runs its own resource-capped container, so keep this at or below the
# CPU count and remember the containers' memory is NOT covered by MemoryMax below.
Environment=JUDGE_WORKERS=3
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/opt/hireflow/venv/bin:/usr/local/bin:/usr/bin:/bin

# ProtectHome=true below makes /home unreadable, so the docker CLI cannot open its
# default config at $HOME/.docker/config.json and printed
#   WARNING: Error loading config file: open /home/hfjudge/.docker/config.json:
#   permission denied
# on its stderr — the same stream the container's stderr arrives on, so every
# candidate saw it in their program's error output.
#
# Point both at a directory this service can actually reach. The directory does not
# need to exist: the CLI is silent on ENOENT, and only warns when a path exists but
# cannot be read. HOME is set too because ProtectHome leaves it dangling for
# anything else that looks there.
Environment=HOME=/srv/judge_work
Environment=DOCKER_CONFIG=/srv/judge_work/.docker

ExecStart=/bin/sh /opt/hireflow/backend/entrypoint.sh

Restart=always
RestartSec=5

# ── Resource limits: this server also hosts other cPanel accounts ────────────
# Lowest priority on the box — a candidate's submission must never slow down
# another account's website.
#
# IMPORTANT: these limits bound THIS worker process only. The sandboxes it
# launches are separate Docker containers with their own cgroups, capped by
# --memory / --cpus / --pids-limit in src/judge/sandbox.py. Both layers matter:
# this one stops the queue runner leaking, that one stops submitted code from
# consuming the machine.
MemoryMax=2G
CPUWeight=30
IOWeight=30

# ── Confinement of the worker process itself ─────────────────────────────────
# The worker only needs to: read the app code, write candidates' job directories
# under /srv/judge_work, and talk to Redis, MySQL and the Docker socket. Everything
# else is taken away, so a bug in the worker (not the sandbox) reaches as little as
# possible. As above, none of this applies to the containers, which dockerd starts.
#
# strict: the whole filesystem is read-only except ReadWritePaths. (It was `full`,
# which leaves /opt writable — ReadWritePaths=/opt/hireflow granted nothing extra,
# and the app's code and uploads were writable by the one docker-group process.)
ProtectSystem=strict
ReadWritePaths=/srv/judge_work
ProtectHome=true
PrivateTmp=true
# The docker CLI needs no setuid binary and no new privileges; the docker group is
# what grants socket access.
NoNewPrivileges=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# Unix sockets (Docker) and TCP (Redis, MySQL, Gemini for test generation).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Three pool workers plus a docker client each; a runaway loop stops here.
TasksMax=256
# No UMask=: job files must stay readable by the container's `nobody` user. The
# 0700 work root (set by the worker at startup) is what keeps other accounts out.

[Install]
WantedBy=multi-user.target
